{
  "name": "@northschema/plugin-xrpl",
  "description": "Reads public XRPL ledger state for elizaOS agents. Read-only: no signing, no key material, no transaction submission.",
  "version": "0.2.0",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "packageType": "plugin",
  "platform": "node",
  "license": "MIT",
  "author": "Brian Araujo <nctrnlsoul@users.noreply.github.com>",
  "keywords": [
    "plugin",
    "elizaos",
    "xrpl",
    "xrp",
    "ledger",
    "read-only"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nctrnlsoul/plugin-ns-xrpl.git"
  },
  "homepage": "https://github.com/nctrnlsoul/plugin-ns-xrpl#readme",
  "bugs": {
    "url": "https://github.com/nctrnlsoul/plugin-ns-xrpl/issues"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "peerDependencies": {
    "@elizaos/core": ">=2.0.3-beta.7 <3.0.0-0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.14",
    "@elizaos/core": "2.0.3-beta.7",
    "@types/node": "^25.0.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.4"
  },
  "scripts": {
    "build": "bun run build.ts",
    "build:watch": "bun run build.ts --watch",
    "typecheck": "tsc --noEmit",
    "lint": "biome check --write ./src ./check.ts ./checks",
    "lint:check": "biome check ./src ./check.ts ./checks",
    "format": "biome format --write ./src ./check.ts ./checks",
    "format:check": "biome format ./src ./check.ts ./checks",
    "test": "vitest run src/__tests__",
    "test:watch": "vitest watch src/__tests__",
    "audit": "bun audit",
    "gate": "bun run check.ts",
    "verify": "bun run typecheck && bun run lint:check && bun run test && bun run audit && bun run gate && bun run package:check",
    "package:check": "bun checks/package_entries.ts",
    "prepublishOnly": "bun run verify"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "agentConfig": {
    "pluginType": "elizaos:plugin:1.0.0",
    "pluginParameters": {}
  }
}
